{
  "compilerOptions": {
    /* Language and Environment */
    "target": "esnext",
    "module": "commonjs",
    "lib": ["esnext"],

    /* Output */
    "rootDir": "./",
    "outDir": "./dist",
    "removeComments": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
